# Canonical clean-URL redirects.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep the blog subdomain on its own host and force HTTPS there.
  RewriteCond %{HTTP_HOST} ^blog\.ovidesign\.in$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://blog.ovidesign.in%{REQUEST_URI} [R=301,L,NE]

  # Canonicalize every non-blog host to the HTTPS main domain.
  RewriteCond %{HTTP_HOST} !^blog\.ovidesign\.in$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^ovidesign\.in$ [NC]
  RewriteRule ^ https://ovidesign.in%{REQUEST_URI} [R=301,L,NE]

  # Send the former local blog and its permalinks to the blog subdomain.
  RewriteRule ^blog(?:/(.*))?/?$ https://blog.ovidesign.in/$1 [R=301,L,NE]

  # Never expose index.html, including inside canonical page folders.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ / [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+(.+/)index\.html(?:[?\s]) [NC]
  RewriteRule ^(.+/)index\.html$ /$1 [R=301,L,NE]

  # Send folder-only requests to the canonical keyword-named HTML files.
  RewriteRule ^about-ovi-design-academy-mentor-chennai/?$ /about-ovi-design-academy-mentor-chennai/ui-ux-design-mentor-chennai.html [R=301,L,NC]
  RewriteRule ^contact-ovi-design-academy-kolathur-chennai/?$ /contact-ovi-design-academy-kolathur-chennai/ovi-design-academy-kolathur-contact.html [R=301,L,NC]
  RewriteRule ^faq-ui-ux-design-course-chennai/?$ /faq-ui-ux-design-course-chennai/ui-ux-course-fees-placement-faq.html [R=301,L,NC]
  RewriteRule ^life-at-ovi-design-academy-chennai/?$ /life-at-ovi-design-academy-chennai/ui-ux-design-classes-chennai.html [R=301,L,NC]
  RewriteRule ^ui-ui-design-student-portfolio/?$ /ui-ui-design-student-portfolio/ui-ux-designer-portfolio-chennai.html [R=301,L,NC]
  RewriteRule ^ui-ux-courses-chennai/?$ /ui-ux-courses-chennai/best-ui-ux-courses-in-chennai.html [R=301,L,NC]
  RewriteRule ^courses/advanced-ui-ux-ai-design-course-chennai/?$ /courses/advanced-ui-ux-ai-design-course-chennai/advanced-ui-ux-ai-course-chennai.html [R=301,L,NC]
  RewriteRule ^courses/ui-ux-design-course-fees-chennai/?$ /courses/ui-ux-design-course-fees-chennai/ui-ux-design-course-fees-comparison.html [R=301,L,NC]
  RewriteRule ^courses/ux-ui-ai-vibe-design-course-chennai/?$ /courses/ux-ui-ai-vibe-design-course-chennai/ux-ui-ai-vibe-design-program-chennai.html [R=301,L,NC]

  # Redirect the previous clean folder URLs to the keyword-focused folders.
  RewriteRule ^student-work/?$ /ui-ui-design-student-portfolio/ui-ux-designer-portfolio-chennai.html [R=301,L,NC]
  RewriteRule ^ui-ux-design-portfolio/?$ /ui-ui-design-student-portfolio/ui-ux-designer-portfolio-chennai.html [R=301,L,NC]
  RewriteRule ^courses/compare-ui-ux-courses/?$ /courses/ui-ux-design-course-fees-chennai/ui-ux-design-course-fees-comparison.html [R=301,L,NC]
  RewriteRule ^courses/advanced-ui-ux-ai-leadership/?$ /courses/advanced-ui-ux-ai-design-course-chennai/advanced-ui-ux-ai-course-chennai.html [R=301,L,NC]
  RewriteRule ^life-at-ovi/?$ /life-at-ovi-design-academy-chennai/ui-ux-design-classes-chennai.html [R=301,L,NC]
  RewriteRule ^faq/?$ /faq-ui-ux-design-course-chennai/ui-ux-course-fees-placement-faq.html [R=301,L,NC]
  RewriteRule ^about/?$ /about-ovi-design-academy-mentor-chennai/ui-ux-design-mentor-chennai.html [R=301,L,NC]
  RewriteRule ^contact/?$ /contact-ovi-design-academy-kolathur-chennai/ovi-design-academy-kolathur-contact.html [R=301,L,NC]
  RewriteRule ^courses/?$ /ui-ux-courses-chennai/best-ui-ux-courses-in-chennai.html [R=301,L,NC]

  # Current flat files and known historical aliases.
  RewriteRule ^index-1\.html$ / [R=301,L,NC]
  RewriteRule ^(?:ux-ui-masterclass-ai-vibe-design-ovi-design-academy|ux-ui-design-course-in-chennai|ux-ui-design-course-chennai|ux-ui-design)\.html$ /courses/ux-ui-ai-vibe-design-course-chennai/ux-ui-ai-vibe-design-program-chennai.html [R=301,L,NC]
  RewriteRule ^courses/ui-ux-design-course-chennai/?$ /courses/ux-ui-ai-vibe-design-course-chennai/ux-ui-ai-vibe-design-program-chennai.html [R=301,L,NC]
  RewriteRule ^(?:advanced-ux-ui-ai-leadership-program-ovi-design-academy|advanced-ux-ui-ai-course-chennai)\.html$ /courses/advanced-ui-ux-ai-design-course-chennai/advanced-ui-ux-ai-course-chennai.html [R=301,L,NC]
  RewriteRule ^compare-ux-ui-courses-chennai\.html$ /courses/ui-ux-design-course-fees-chennai/ui-ux-design-course-fees-comparison.html [R=301,L,NC]
  RewriteRule ^(?:all-course-ux-ui-ovi-design-academy|all-design-course|all-design-courses|design-courses-in-chennai|design-courses-chennai|courses|web-design|web-design-course-chennai|web-design-course-in-chennai|graphic-design|graphic-design-course-chennai|graphic-design-course-in-chennai)\.html$ /ui-ux-courses-chennai/best-ui-ux-courses-in-chennai.html [R=301,L,NC]
  RewriteRule ^about-ovi-design-academy-chennai\.html$ /about-ovi-design-academy-mentor-chennai/ui-ux-design-mentor-chennai.html [R=301,L,NC]
  RewriteRule ^(?:students-works-ovi-design-academy|students-works|student-portfolio-chennai|ux-ui-student-portfolio-chennai)\.html$ /ui-ui-design-student-portfolio/ui-ux-designer-portfolio-chennai.html [R=301,L,NC]
  RewriteRule ^life-at-ovi-design-academy-chennai\.html$ /life-at-ovi-design-academy-chennai/ui-ux-design-classes-chennai.html [R=301,L,NC]
  RewriteRule ^(?:faq-ovi-design-academy|faq|ux-ui-course-faqs-chennai)\.html$ /faq-ui-ux-design-course-chennai/ui-ux-course-fees-placement-faq.html [R=301,L,NC]
  RewriteRule ^contact-ovi-design-academy-chennai\.html$ /contact-ovi-design-academy-kolathur-chennai/ovi-design-academy-kolathur-contact.html [R=301,L,NC]
  RewriteRule ^about\.html$ /about-ovi-design-academy-mentor-chennai/ui-ux-design-mentor-chennai.html [R=301,L,NC]
  RewriteRule ^contact\.html$ /contact-ovi-design-academy-kolathur-chennai/ovi-design-academy-kolathur-contact.html [R=301,L,NC]
  RewriteRule ^life-at-ovi\.html$ /life-at-ovi-design-academy-chennai/ui-ux-design-classes-chennai.html [R=301,L,NC]
  RewriteRule ^all-design-courses/?$ /ui-ux-courses-chennai/best-ui-ux-courses-in-chennai.html [R=301,L,NC]
  RewriteRule ^demo-class\.html$ /demo-class/ [R=301,L,NC]

  # Retire the indexed WordPress /new/ section without creating new duplicates.
  RewriteRule ^new/?$ / [R=301,L,NC]
  RewriteRule ^new/(?:about-us|about)/?$ /about-ovi-design-academy-mentor-chennai/ui-ux-design-mentor-chennai.html [R=301,L,NC]
  RewriteRule ^new/(?:contact-us|contact)/?$ /contact-ovi-design-academy-kolathur-chennai/ovi-design-academy-kolathur-contact.html [R=301,L,NC]
  RewriteRule ^new/(?:student[^/]*)/?$ /ui-ui-design-student-portfolio/ui-ux-designer-portfolio-chennai.html [R=301,L,NC]
  RewriteRule ^new/[^/]*course[^/]*/?$ /ui-ux-courses-chennai/best-ui-ux-courses-in-chennai.html [R=301,L,NC]
  RewriteRule ^new/.+$ https://blog.ovidesign.in/ [R=301,L,NC]

</IfModule>

# Compress text assets when supported by the Hostinger Apache stack.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Cache versioned code and fingerprint-stable media while keeping HTML fresh.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 month"
</IfModule>

# Production security headers (requires mod_headers).
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://docs.google.com https://ovidesign.us14.list-manage.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.instagram.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https://docs.google.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://www.instagram.com; frame-src https://www.google.com https://www.youtube.com https://www.instagram.com; media-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# Do not expose directory listings or hidden configuration files.
Options -Indexes
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "^(vercel\.json|_headers|_redirects|design-qa\.md)$">
  Require all denied
</FilesMatch>
