# Canonical clean-URL redirects.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never expose index.html, including inside canonical page folders.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ / [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+(.+/)index\.html(?:[?\s]) [NC]
  RewriteRule ^(.+/)index\.html$ /$1 [R=301,L,NE]

  # Current flat files and known historical aliases.
  RewriteRule ^index-1\.html$ / [R=301,L,NC]
  RewriteRule ^(?:ux-ui-masterclass-ai-vibe-design-ovi-design-academy|ux-ui-design-course-in-chennai|ux-ui-design-course-chennai|ux-ui-design)\.html$ /courses/ui-ux-design-course-chennai/ [R=301,L,NC]
  RewriteRule ^(?:advanced-ux-ui-ai-leadership-program-ovi-design-academy|advanced-ux-ui-ai-course-chennai)\.html$ /courses/advanced-ui-ux-ai-leadership/ [R=301,L,NC]
  RewriteRule ^compare-ux-ui-courses-chennai\.html$ /courses/compare-ui-ux-courses/ [R=301,L,NC]
  RewriteRule ^(?:all-course-ux-ui-ovi-design-academy|all-design-course|all-design-courses|design-courses-in-chennai|design-courses-chennai|courses|web-design|web-design-course-chennai|web-design-course-in-chennai|graphic-design|graphic-design-course-chennai|graphic-design-course-in-chennai)\.html$ /courses/ [R=301,L,NC]
  RewriteRule ^about-ovi-design-academy-chennai\.html$ /about/ [R=301,L,NC]
  RewriteRule ^(?:students-works-ovi-design-academy|students-works|student-portfolio-chennai|ux-ui-student-portfolio-chennai)\.html$ /student-work/ [R=301,L,NC]
  RewriteRule ^life-at-ovi-design-academy-chennai\.html$ /life-at-ovi/ [R=301,L,NC]
  RewriteRule ^(?:faq-ovi-design-academy|faq|ux-ui-course-faqs-chennai)\.html$ /faq/ [R=301,L,NC]
  RewriteRule ^contact-ovi-design-academy-chennai\.html$ /contact/ [R=301,L,NC]
  RewriteRule ^about\.html$ /about/ [R=301,L,NC]
  RewriteRule ^contact\.html$ /contact/ [R=301,L,NC]
  RewriteRule ^life-at-ovi\.html$ /life-at-ovi/ [R=301,L,NC]
  RewriteRule ^all-design-courses/?$ /courses/ [R=301,L,NC]
  RewriteRule ^demo-class\.html$ /demo-class/ [R=301,L,NC]

  # Retire the indexed WordPress /new/ section without creating new duplicates.
  RewriteRule ^new/?$ / [R=301,L,NC]
  RewriteRule ^new/(?:about-us|about)/?$ /about/ [R=301,L,NC]
  RewriteRule ^new/(?:contact-us|contact)/?$ /contact/ [R=301,L,NC]
  RewriteRule ^new/(?:student[^/]*)/?$ /student-work/ [R=301,L,NC]
  RewriteRule ^new/[^/]*course[^/]*/?$ /courses/ [R=301,L,NC]
  RewriteRule ^new/.+$ /blog/ [R=301,L,NC]

  # Serve the branded 404 page while preserving the missing URL and status.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>

# Production security headers (requires mod_headers).
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://docs.google.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.instagram.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https://docs.google.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://www.instagram.com; frame-src https://www.google.com https://www.youtube.com https://www.instagram.com; media-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# Do not expose directory listings or hidden configuration files.
Options -Indexes
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "^(vercel\.json|_headers|_redirects|design-qa\.md)$">
  Require all denied
</FilesMatch>
